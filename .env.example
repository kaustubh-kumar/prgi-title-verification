# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ------------------------------------------------------
# Provider is selected via LLM_PROVIDER (default: gemini). Only Gemini is
# implemented so far (src/llm/gemini.py).
GEMINI_API_KEY=
# Optional - overrides the default Gemini model (src/llm/gemini.py).
# GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=

# --- Database ------------------------------------------------------------
# A standard Postgres connection string - either your Supabase project's
# connection string (Project Settings -> Database -> Connection string),
# or a local Postgres URL during development
# (e.g. postgresql:///prgi_sys for a local trust-auth database).
# NEVER put a Supabase service-role key here or anywhere the frontend can
# read it - this backend talks to Postgres directly, not through the
# Supabase REST/anon-key client.
SUPABASE_DB_URL=

# --- API server ------------------------------------------------------------
# Comma-separated list of origins allowed to call this API (CORS). Should
# be your deployed frontend's origin in production. Defaults to common
# local dev origins if unset - see src/api/main.py.
# FRONTEND_ORIGIN=http://localhost:8765
#
# How many candidates are used for the actual evidence/scoring pass
# (Postgres blocks a larger pool first - see src/db/corpus.py). Default 10.
# VERIFY_TOP_K=10
